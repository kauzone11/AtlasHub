  DRAFT
  ACTIVE
  AT_RISK
  COMPLETED
  CANCELLED
}

enum HubStrategicPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum HubKeyResultDirection {
  INCREASE
  DECREASE
  MAINTAIN
}

enum HubKeyResultStatus {
  ACTIVE
  AT_RISK
  COMPLETED
  CANCELLED
}

enum HubStrategicInitiativeStatus {
  PLANNED
  ACTIVE
  BLOCKED
  COMPLETED
  CANCELLED
}

enum HubIndicatorFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
  MANUAL
}

enum HubStrategicRiskStatus {
  OPEN
  MONITORING
  MITIGATED
  ACCEPTED
  CLOSED
}

enum HubStrategicReviewStatus {
  DRAFT
  CLOSED
}

enum HubGrowthOrganizationStatus {
  PROSPECT
  CUSTOMER
  PARTNER
  INACTIVE
}

enum HubLeadSource {
  REFERRAL
  SOCIAL
  EVENT
  OUTBOUND
  INBOUND
  PARTNERSHIP
  OTHER
}

enum HubLeadStatus {
  NEW
  QUALIFYING
  QUALIFIED
  DISQUALIFIED
  CONVERTED
}

enum HubOpportunityStatus {
  OPEN
  WON
  LOST
  CANCELLED
}

enum HubOpportunityActivityType {
  NOTE
  CALL
  MEETING
  EMAIL
  TASK
  FOLLOW_UP
}

enum HubProposalStatus {
  DRAFT
  INTERNAL_REVIEW
  APPROVED
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum HubPartnershipStatus {
  PROPOSED
  ACTIVE
  PAUSED
  ENDED
  CANCELLED
}

model HubStrategyCycle {
  id             String                  @id @default(cuid())
  organizationId String
  organization   HubOrganization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  startsAt       DateTime                @db.Date
  endsAt         DateTime                @db.Date
  status         HubStrategyCycleStatus  @default(DRAFT)
  allowOverlap   Boolean                 @default(false)
  version        Int                     @default(1)
  createdById    String
  closedAt       DateTime?
  archivedAt     DateTime?
  objectives     HubStrategicObjective[]
  risks          HubStrategicRisk[]
  reviews        HubStrategicReview[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, status, startsAt, endsAt])
}

model HubStrategicObjective {
  id             String                      @id @default(cuid())
  organizationId String
  organization   HubOrganization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cycleId        String
  cycle          HubStrategyCycle            @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  directorateId  String?
  title          String
  description    String?
  ownerMemberId  String?
  status         HubStrategicObjectiveStatus @default(DRAFT)
  priority       HubStrategicPriority        @default(MEDIUM)
  progress       Int                         @default(0)
  startsAt       DateTime?                   @db.Date
  dueAt          DateTime?                   @db.Date
  completedAt    DateTime?
  version        Int                         @default(1)
  keyResults     HubKeyResult[]
  initiatives    HubStrategicInitiative[]
  risks          HubStrategicRisk[]
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@index([organizationId, cycleId, directorateId])
  @@index([organizationId, ownerMemberId, status])
}

model HubKeyResult {
  id             String                @id @default(cuid())
  organizationId String
  organization   HubOrganization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  objectiveId    String
  objective      HubStrategicObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  title          String
  ownerMemberId  String?
  unit           String
  startValue     Decimal               @db.Decimal(24, 6)
  targetValue    Decimal               @db.Decimal(24, 6)
  currentValue   Decimal               @db.Decimal(24, 6)
  direction      HubKeyResultDirection
  weight         Decimal               @db.Decimal(7, 4)
  status         HubKeyResultStatus    @default(ACTIVE)
  version        Int                   @default(1)
  histories      HubKeyResultHistory[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([organizationId, objectiveId])
  @@index([organizationId, ownerMemberId, status])
}

model HubKeyResultHistory {
  id             String       @id @default(cuid())
  organizationId String
  keyResultId    String
  keyResult      HubKeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  previousValue  Decimal      @db.Decimal(24, 6)
  value          Decimal      @db.Decimal(24, 6)
  progress       Decimal      @db.Decimal(7, 4)
  notes          String?
  recordedById   String
  createdAt      DateTime     @default(now())

  @@index([organizationId, keyResultId, createdAt])
}

model HubStrategicInitiative {
  id             String                       @id @default(cuid())
  organizationId String
  organization   HubOrganization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  objectiveId    String?
  objective      HubStrategicObjective?       @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  boardId        String?
  projectId      String?
  opportunityId  String?
  title          String
  description    String?
  ownerMemberId  String?
  directorateId  String?
  status         HubStrategicInitiativeStatus @default(PLANNED)
  startsAt       DateTime?                    @db.Date
  dueAt          DateTime?                    @db.Date
  progress       Int                          @default(0)
  version        Int                          @default(1)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  @@index([organizationId, directorateId, status])
  @@index([objectiveId])
}

model HubStrategicIndicator {
  id             String                    @id @default(cuid())
  organizationId String
  organization   HubOrganization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  unit           String
  direction      HubKeyResultDirection
  frequency      HubIndicatorFrequency
  ownerMemberId  String?
  directorateId  String?
  targetValue    Decimal                   @db.Decimal(24, 6)
  isActive       Boolean                   @default(true)
  version        Int                       @default(1)
  measurements   HubIndicatorMeasurement[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, directorateId, isActive])
}

model HubIndicatorMeasurement {
  id             String                @id @default(cuid())
  organizationId String
  organization   HubOrganization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  indicatorId    String
  indicator      HubStrategicIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  measuredAt     DateTime
  periodKey      String
  value          Decimal               @db.Decimal(24, 6)
  notes          String?
  recordedById   String
  idempotencyKey String
  requestHash    String
  createdAt      DateTime              @default(now())

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, indicatorId, measuredAt(sort: Desc)])
}

model HubStrategicRisk {
  id             String                    @id @default(cuid())
  organizationId String
  organization   HubOrganization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cycleId        String
  cycle          HubStrategyCycle          @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  objectiveId    String?
  objective      HubStrategicObjective?    @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  directorateId  String?
  title          String
  description    String?
  category       String
  probability    Int
  impact         Int
  score          Int
  status         HubStrategicRiskStatus    @default(OPEN)
  ownerMemberId  String?
  mitigation     String?
  reviewDate     DateTime?                 @db.Date
  version        Int                       @default(1)
  histories      HubStrategicRiskHistory[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([organizationId, cycleId, directorateId, status])
}

model HubStrategicRiskHistory {
  id             String                 @id @default(cuid())
  organizationId String
  riskId         String
  risk           HubStrategicRisk       @relation(fields: [riskId], references: [id], onDelete: Cascade)
  status         HubStrategicRiskStatus
  probability    Int
  impact         Int
  score          Int
  mitigation     String?
  changedById    String
  createdAt      DateTime               @default(now())

  @@index([organizationId, riskId, createdAt])
}

model HubStrategicReview {
  id                   String                   @id @default(cuid())
  organizationId       String
  organization         HubOrganization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cycleId              String
  cycle                HubStrategyCycle         @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  meetingId            String?
  reviewDate           DateTime                 @db.Date
  participantMemberIds String[]
  summary              String?
  objectiveSnapshots   Json?
  indicatorSnapshots   Json?
  riskSummary          Json?
  decisions            Json?
  nextActions          Json?
  status               HubStrategicReviewStatus @default(DRAFT)
  version              Int                      @default(1)
  closedAt             DateTime?
  closedById           String?
  createdById          String
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([organizationId, cycleId, reviewDate])
  @@index([meetingId])
}

model HubGrowthOrganization {
  id             String                      @id @default(cuid())
  organizationId String
  organization   HubOrganization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  document       String?
  website        String?
  industry       String?
  city           String?
  state          String?
  country        String                      @default("BR")
  notes          String?
  status         HubGrowthOrganizationStatus @default(PROSPECT)
  contacts       HubGrowthContact[]
  leads          HubLead[]
  opportunities  HubOpportunity[]
  partnerships   HubPartnership[]
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@unique([organizationId, normalizedName])
  @@index([organizationId, status])
}

model HubGrowthContact {
  id                   String                @id @default(cuid())
  organizationId       String
  organization         HubOrganization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  growthOrganizationId String
  growthOrganization   HubGrowthOrganization @relation(fields: [growthOrganizationId], references: [id], onDelete: Cascade)
  name                 String
  role                 String?
  email                String?
  normalizedEmail      String?
  phone                String?
  linkedinUrl          String?
  isPrimary            Boolean               @default(false)
  isActive             Boolean               @default(true)
  notes                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([growthOrganizationId, normalizedEmail])
  @@index([organizationId, growthOrganizationId, isActive])
}

model HubLead {
  id                     String                 @id @default(cuid())
  organizationId         String
  organization           HubOrganization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  growthOrganizationId   String?
  growthOrganization     HubGrowthOrganization? @relation(fields: [growthOrganizationId], references: [id], onDelete: SetNull)
  title                  String
  source                 HubLeadSource
  status                 HubLeadStatus          @default(NEW)
  ownerMemberId          String?
  directorateId          String?
  notes                  String?
  disqualificationReason String?
  idempotencyKey         String
  requestHash            String
  convertedOpportunityId String?
  convertedAt            DateTime?
  version                Int                    @default(1)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, directorateId])
}

model HubPipelineStage {
  id             String           @id @default(cuid())
  organizationId String
  organization   HubOrganization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  order          Int
  probability    Int
  isWon          Boolean          @default(false)
  isLost         Boolean          @default(false)
  isActive       Boolean          @default(true)
  version        Int              @default(1)
  opportunities  HubOpportunity[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, order])
  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model HubOpportunity {
  id                        String                       @id @default(cuid())
  organizationId            String
  organization              HubOrganization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  growthOrganizationId      String
  growthOrganization        HubGrowthOrganization        @relation(fields: [growthOrganizationId], references: [id], onDelete: Restrict)
  primaryContactId          String?
  title                     String
  description               String?
  ownerMemberId             String?
  directorateId             String?
  stageId                   String
  stage                     HubPipelineStage             @relation(fields: [stageId], references: [id], onDelete: Restrict)
  status                    HubOpportunityStatus         @default(OPEN)
  estimatedValueCents       Int                          @default(0)
  currency                  String
  expectedCloseDate         DateTime?                    @db.Date
  source                    HubLeadSource
  probability               Int
  probabilityOverride       Int?
  probabilityOverrideReason String?
  nextAction                String?
  nextActionAt              DateTime?
  lossReason                String?
  cancellationReason        String?
  wonAt                     DateTime?
  lostAt                    DateTime?
  cancelledAt               DateTime?
  version                   Int                          @default(1)
  sourceLeadId              String?
  projectId                 String?
  projectCreationKey        String?
  activities                HubOpportunityActivity[]
  proposals                 HubProposal[]
  stageHistory              HubOpportunityStageHistory[]
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt

  @@unique([organizationId, sourceLeadId])
  @@unique([organizationId, projectCreationKey])
  @@index([organizationId, stageId, status])
  @@index([organizationId, directorateId, ownerMemberId])
}

model HubOpportunityStageHistory {
  id             String               @id @default(cuid())
  organizationId String
  opportunityId  String
  opportunity    HubOpportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromStageId    String?
  toStageId      String
  fromStatus     HubOpportunityStatus
  toStatus       HubOpportunityStatus
  reason         String?
  changedById    String
  createdAt      DateTime             @default(now())

  @@index([organizationId, opportunityId, createdAt])
}

model HubOpportunityActivity {
  id                 String                     @id @default(cuid())
  organizationId     String
  organization       HubOrganization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunityId      String
  opportunity        HubOpportunity             @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  type               HubOpportunityActivityType
  title              String
  description        String?
  occurredAt         DateTime
  nextActionAt       DateTime?
  meetingId          String?
  taskId             String?
  replacesActivityId String?
  cancelledAt        DateTime?
  cancellationReason String?
  createdById        String
  createdAt          DateTime                   @default(now())

  @@index([organizationId, opportunityId, occurredAt(sort: Desc)])
}

model HubProposal {
  id                 String                @id @default(cuid())
  organizationId     String
  organization       HubOrganization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunityId      String
  opportunity        HubOpportunity        @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  title              String
  summary            String?
  validUntil         DateTime?             @db.Date
  currency           String
  subtotalCents      Int                   @default(0)
  discountCents      Int                   @default(0)
  totalCents         Int                   @default(0)
  status             HubProposalStatus     @default(DRAFT)
  createdById        String
  approvedById       String?
  sentAt             DateTime?
  acceptedAt         DateTime?
  rejectedAt         DateTime?
  rejectionReason    String?
  expiredAt          DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  version            Int                   @default(1)
  activeRevisionId   String?
  projectId          String?
  projectCreationKey String?
  revisions          HubProposalRevision[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([organizationId, projectCreationKey])
  @@index([organizationId, opportunityId, status])
}

model HubProposalRevision {
  id              String            @id @default(cuid())
  organizationId  String
  organization    HubOrganization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposalId      String
  proposal        HubProposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  revisionNumber  Int
  scope           String
  deliverables    String
  timeline        String
  commercialTerms String
  isLocked        Boolean           @default(false)
  createdById     String
  items           HubProposalItem[]
  createdAt       DateTime          @default(now())

  @@unique([proposalId, revisionNumber])
  @@index([organizationId, proposalId])
}

model HubProposalItem {
  id               String              @id @default(cuid())
  organizationId   String
  organization     HubOrganization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  revisionId       String
  revision         HubProposalRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  description      String
  quantity         Decimal             @db.Decimal(18, 4)
  unitAmountCents  Int
  totalAmountCents Int
  order            Int

  @@unique([revisionId, order])
  @@index([organizationId, revisionId])
}

model HubPartnership {
  id                   String                @id @default(cuid())
  organizationId       String
  organization         HubOrganization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  growthOrganizationId String
  growthOrganization   HubGrowthOrganization @relation(fields: [growthOrganizationId], references: [id], onDelete: Restrict)
  title                String
  type                 String
  ownerMemberId        String?
  status               HubPartnershipStatus  @default(PROPOSED)
  startsAt             DateTime?             @db.Date
  endsAt               DateTime?             @db.Date
  goals                String?
  notes                String?
  opportunityId        String?
  initiativeId         String?
  version              Int                   @default(1)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([organizationId, status, ownerMemberId])
}

model HubStrategicGrowthMutation {
  id             String          @id @default(cuid())
  organizationId String
  organization   HubOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scope          String
  idempotencyKey String
  requestHash    String
  entityType     String
  entityId       String
  createdAt      DateTime        @default(now())

  @@unique([organizationId, scope, idempotencyKey])
  @@index([organizationId, entityType, entityId])
}
