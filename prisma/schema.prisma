generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HubOrganization {
  id                  String              @id @default(cuid())
  name                String
  hubName             String
  slug                String              @unique(map: "EconomikWorkspace_slug_key")
  logoUrl             String?
  timezone            String              @default("America/Sao_Paulo")
  locale              String              @default("pt-BR")
  currency            String              @default("BRL")
  isActive            Boolean             @default(true)
  version             Int                 @default(1)
  publicName          String?
  legalName           String?
  document            String?
  institutionalEmail  String?
  phone               String?
  website             String?
  city                String?
  state               String?
  country             String              @default("BR")
  type                HubOrganizationType @default(JUNIOR_ENTERPRISE)
  responsibleMemberId String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  directorates           HubDirectorate[]
  members                HubMember[]
  memberInvitations      HubMemberInvitation[]
  projects               HubProject[]
  financialRule          HubFinancialRule?
  auditLogs              HubAuditLog[]
  notifications          HubNotification[]
  availabilityRules      HubAvailabilityRule[]
  availabilityExceptions HubAvailabilityException[]
  meetings               HubMeeting[]
  meetingResponseEvents  HubMeetingResponseEvent[]
  boards                 HubBoard[]
  tasks                  HubTask[]
  calendarEvents         HubCalendarEvent[]
  availabilityPolls      HubAvailabilityPoll[]
  strategyCycles         HubStrategyCycle[]
  strategicObjectives    HubStrategicObjective[]
  keyResults             HubKeyResult[]
  strategicInitiatives   HubStrategicInitiative[]
  strategicIndicators    HubStrategicIndicator[]
  indicatorMeasurements  HubIndicatorMeasurement[]
  strategicRisks         HubStrategicRisk[]
  strategicReviews       HubStrategicReview[]
  growthOrganizations    HubGrowthOrganization[]
  growthContacts         HubGrowthContact[]
  leads                  HubLead[]
  pipelineStages         HubPipelineStage[]
  opportunities          HubOpportunity[]
  opportunityActivities  HubOpportunityActivity[]
  proposals              HubProposal[]
  proposalRevisions      HubProposalRevision[]
  proposalItems          HubProposalItem[]
  partnerships           HubPartnership[]
  mutationKeys           HubStrategicGrowthMutation[]
  accountsLastUsed       HubAccount[]                 @relation("HubAccountLastOrganization")
  workspaceLink          WorkspaceHubLink?
  responsibleMember      HubMember?                   @relation("HubResponsibleMember", fields: [responsibleMemberId], references: [id], onDelete: SetNull)

  @@map("EconomikWorkspace")
}

enum HubOrganizationType {
  JUNIOR_ENTERPRISE
  ASSOCIATION
  FOUNDATION
  COMPANY
  PUBLIC_ORGANIZATION
  OTHER
}

enum HubAccountStatus {
  ACTIVE
  DISABLED
}

model HubAccount {
  id                 String           @id @default(cuid())
  email              String
  normalizedEmail    String           @unique
  passwordHash       String
  status             HubAccountStatus @default(ACTIVE)
  mustChangePassword Boolean          @default(true)
  sessionVersion     Int              @default(1)
  lastOrganizationId String?
  lastOrganization   HubOrganization? @relation("HubAccountLastOrganization", fields: [lastOrganizationId], references: [id], onDelete: SetNull)
  memberships        HubMember[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([lastOrganizationId])
}

enum HubMemberInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum HubInvitationDeliveryStatus {
  PENDING
  SENT
  FAILED
  NOT_CONFIGURED
}

model HubMemberInvitation {
  id                      String                      @id @default(cuid())
  organizationId          String
  organization            HubOrganization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  normalizedEmail         String
  tokenHash               String                      @unique
  status                  HubMemberInvitationStatus   @default(PENDING)
  organizationPosition    HubOrganizationPosition
  memberCategory          HubMemberCategory
  directorateId           String?
  directorate             HubDirectorate?             @relation(fields: [directorateId], references: [id], onDelete: SetNull)
  appointAsDirector       Boolean                     @default(false)
  invitedById             String
  invitedBy               HubMember                   @relation("HubInvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  existingInvitedMemberId String?
  existingInvitedMember   HubMember?                  @relation("HubInvitationLegacyMember", fields: [existingInvitedMemberId], references: [id], onDelete: SetNull)
  deliveryStatus          HubInvitationDeliveryStatus @default(PENDING)
  deliveryAttempts        Int                         @default(0)
  lastDeliveryAt          DateTime?
  lastDeliveryError       String?
  expiresAt               DateTime
  acceptedAt              DateTime?
  revokedAt               DateTime?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  version                 Int                         @default(1)

  @@index([organizationId, status, createdAt])
  @@index([organizationId, normalizedEmail])
  @@index([existingInvitedMemberId])
}

model WorkspaceHubLink {
  id                  String          @id @default(cuid())
  hubOrganizationId   String          @unique
  hubOrganization     HubOrganization @relation(fields: [hubOrganizationId], references: [id], onDelete: Cascade)
  atlasOrganizationId String?
  createdByUserId     String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([atlasOrganizationId])
}

model WorkspaceHubMutation {
  id             String   @id @default(cuid())
  scope          String
  idempotencyKey String
  requestHash    String
  resultJson     Json?
  createdAt      DateTime @default(now())

  @@unique([scope, idempotencyKey])
}

model WorkspaceHubAudit {
  id                   String   @id @default(cuid())
  action               String
  hubOrganizationId    String
  organizationName     String
  responsibleAccountId String?
  actorUserId          String?
  safeMetadata         Json?
  createdAt            DateTime @default(now())

  @@index([hubOrganizationId, createdAt])
  @@index([actorUserId, createdAt])
}

model HubDirectorate {
  id             String          @id @default(cuid())
  organizationId String          @map("workspaceId")
  organization   HubOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "EconomikDirectorate_workspaceId_fkey")

  name        String
  slug        String
  description String?
  icon        String?
  isActive    Boolean    @default(true)
  archivedAt  DateTime?
  version     Int        @default(1)
  order       Int        @default(0)
  directorId  String?
  director    HubMember? @relation("HubDirectorateDirector", fields: [directorId], references: [id], onDelete: SetNull)

  members           HubMember[]
  memberInvitations HubMemberInvitation[]
  meetings          HubMeeting[]
  meetingLinks      HubMeetingDirectorate[]
  boards            HubBoard[]
  primaryProjects   HubProject[]            @relation("HubProjectPrimaryDirectorate")
  projectLinks      HubProjectDirectorate[]
  tasks             HubTask[]
  calendarEvents    HubCalendarEvent[]
  availabilityPolls HubAvailabilityPoll[]
  financialEntries  HubFinancialEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, slug], map: "EconomikDirectorate_workspaceId_slug_key")
  @@index([organizationId], map: "EconomikDirectorate_workspaceId_idx")
  @@index([organizationId, archivedAt])
  @@index([directorId])
  @@map("EconomikDirectorate")
}

model HubMember {
  id             String          @id @default(cuid())
  organizationId String          @map("workspaceId")
  organization   HubOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "EconomikMember_workspaceId_fkey")

  email                String
  normalizedEmail      String?
  name                 String
  passwordHash         String
  phone                String?
  position             String?
  organizationPosition HubOrganizationPosition @default(MEMBER)
  memberCategory       HubMemberCategory       @default(MEMBER)
  accountId            String?
  account              HubAccount?             @relation(fields: [accountId], references: [id], onDelete: SetNull)
  isPrimary            Boolean                 @default(false)

  role   HubRole         @default(MEMBER)
  status HubMemberStatus @default(ACTIVE)

  directorateId        String?
  directorate          HubDirectorate?  @relation(fields: [directorateId], references: [id], map: "EconomikMember_directorateId_fkey")
  directedDirectorates HubDirectorate[] @relation("HubDirectorateDirector")

  mustChangePassword Boolean   @default(true)
  sessionVersion     Int       @default(1)
  lastLoginAt        DateTime?

  avatarUrl String?

  walletAccount HubWalletAccount?

  responsibleProjects          HubProject[]                     @relation("EconomikResponsibleMember")
  managedProjects              HubProject[]                     @relation("HubProjectManager")
  projectTeams                 HubProjectTeamMember[]
  createdMetricProjects        HubProject[]                     @relation("EconomikMetricCreatedBy")
  participations               HubProjectParticipant[]
  walletRequests               HubWalletRequest[]
  reviewedRequests             HubWalletRequest[]               @relation("EconomikWalletReviewedBy")
  createdTransactions          HubWalletTransaction[]           @relation("EconomikWalletTransactionCreatedBy")
  auditLogs                    HubAuditLog[]
  receivedNotifications        HubNotification[]                @relation("HubNotificationRecipient")
  actedNotifications           HubNotification[]                @relation("HubNotificationActor")
  availabilityRules            HubAvailabilityRule[]
  availabilityExceptions       HubAvailabilityException[]
  createdMeetings              HubMeeting[]                     @relation("HubMeetingCreator")
  cancelledMeetings            HubMeeting[]                     @relation("HubMeetingCanceller")
  meetingParticipations        HubMeetingParticipant[]
  meetingResponseEvents        HubMeetingResponseEvent[]
  presentedAgendaItems         HubMeetingAgendaItem[]           @relation("HubAgendaPresenter")
  createdDecisions             HubMeetingDecision[]             @relation("HubDecisionCreator")
  createdBoards                HubBoard[]                       @relation("HubBoardCreator")
  createdTasks                 HubTask[]                        @relation("HubTaskCreator")
  taskAssignments              HubTaskAssignee[]
  taskComments                 HubTaskComment[]
  createdCalendarEvents        HubCalendarEvent[]               @relation("HubCalendarEventCreator")
  createdAvailabilityPolls     HubAvailabilityPoll[]            @relation("HubAvailabilityPollCreator")
  availabilityPollParticipants HubAvailabilityPollParticipant[]
  availabilitySelections       HubAvailabilitySelection[]
  responsibleFor               HubOrganization[]                @relation("HubResponsibleMember")
  invitationsSent              HubMemberInvitation[]            @relation("HubInvitationInviter")
  secureLegacyInvitations      HubMemberInvitation[]            @relation("HubInvitationLegacyMember")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, normalizedEmail], map: "EconomikMember_workspaceId_normalizedEmail_key")
  @@index([organizationId], map: "EconomikMember_workspaceId_idx")
  @@index([organizationId, organizationPosition], map: "EconomikMember_workspaceId_organizationPosition_idx")
  @@index([organizationId, memberCategory], map: "EconomikMember_workspaceId_memberCategory_idx")
  @@index([directorateId], map: "EconomikMember_directorateId_idx")
  @@index([accountId])
  @@map("EconomikMember")
}

enum HubRole {
  SUPER_ADMIN
  ADMIN
  FINANCE
  DIRECTOR
  MEMBER
  VIEWER

  @@map("EconomikRole")
}

enum HubOrganizationPosition {
  PRESIDENT
  COUNSELOR
  MEMBER
}

enum HubMemberCategory {
  MEMBER
  TRAINEE
  ALUMNI
}

enum HubMemberStatus {
  INVITED
  ACTIVE
  DISABLED
  DELETED

  @@map("EconomikStatus")
}

model HubProject {
  id             String          @id @default(cuid())
  idempotencyKey String?         @unique(map: "EconomikMetricProject_idempotencyKey_key")
  organizationId String          @map("workspaceId")
  organization   HubOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "EconomikMetricProject_workspaceId_fkey")

  title            String
  client           String?
  description      String?
  grossAmountCents Int       @default(0)
  competenceDate   DateTime  @default(now())
  isCollaborative  Boolean   @default(false)
  status           String    @default("DRAFT")
  startDate        DateTime? @db.Date
  deadline         DateTime? @db.Date
  progress         Int       @default(0)
  nextDelivery     String?
  archivedAt       DateTime?
  version          Int       @default(1)

  primaryDirectorateId String?
  primaryDirectorate   HubDirectorate? @relation("HubProjectPrimaryDirectorate", fields: [primaryDirectorateId], references: [id], onDelete: SetNull)
  managerId            String?
  manager              HubMember?      @relation("HubProjectManager", fields: [managerId], references: [id], onDelete: SetNull)

  responsibleMemberId String?
  responsibleMember   HubMember? @relation("EconomikResponsibleMember", fields: [responsibleMemberId], references: [id], map: "EconomikMetricProject_responsibleMemberId_fkey")

  createdById String?
  createdBy   HubMember? @relation("EconomikMetricCreatedBy", fields: [createdById], references: [id], map: "EconomikMetricProject_createdById_fkey")

  participants     HubProjectParticipant[]
  directorates     HubProjectDirectorate[]
  teamMembers      HubProjectTeamMember[]
  tasks            HubTask[]
  milestones       HubProjectMilestone[]
  calendarEvents   HubCalendarEvent[]
  financialEntries HubFinancialEntry[]

  cancelledAt             DateTime?
  cancelledReason         String?
  approvedAt              DateTime?
  approvedMemberPoolCents Int?
  financialRuleSnapshot   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId], map: "EconomikMetricProject_workspaceId_idx")
  @@index([status], map: "EconomikMetricProject_status_idx")
  @@index([organizationId, archivedAt, status])
  @@index([primaryDirectorateId])
  @@index([managerId])
  @@map("EconomikMetricProject")
}

model HubProjectDirectorate {
  id            String         @id @default(cuid())
  projectId     String
  project       HubProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  directorateId String
  directorate   HubDirectorate @relation(fields: [directorateId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())

  @@unique([projectId, directorateId])
  @@index([directorateId])
}

model HubProjectTeamMember {
  id        String     @id @default(cuid())
  projectId String
  project   HubProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberId  String
  member    HubMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([projectId, memberId])
  @@index([memberId])
}

model HubProjectMilestone {
  id          String     @id @default(cuid())
  projectId   String
  project     HubProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueAt       DateTime   @db.Date
  completedAt DateTime?
  version     Int        @default(1)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([projectId, dueAt])
}

model HubProjectParticipant {
  id        String     @id @default(cuid())
  projectId String
  project   HubProject @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "EconomikMetricProjectParticipant_projectId_fkey")

  memberId String
  member   HubMember @relation(fields: [memberId], references: [id], onDelete: Cascade, map: "EconomikMetricProjectParticipant_memberId_fkey")

  percentage  Float
  amountCents Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, memberId], map: "EconomikMetricProjectParticipant_projectId_memberId_key")
  @@index([memberId], map: "EconomikMetricProjectParticipant_memberId_idx")
  @@map("EconomikMetricProjectParticipant")
}

model HubFinancialRule {
  id             String          @id @default(cuid())
  organizationId String          @unique(map: "EconomikFinancialRule_workspaceId_key") @map("workspaceId")
  organization   HubOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "EconomikFinancialRule_workspaceId_fkey")

  organizationSharePct Float @default(50)
  atlasSharePct        Float @default(15)
  memberSharePct       Float @default(35)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("EconomikFinancialRule")
}

model HubWalletAccount {
  id       String    @id @default(cuid())
  memberId String    @unique(map: "EconomikWalletAccount_memberId_key")
  member   HubMember @relation(fields: [memberId], references: [id], onDelete: Cascade, map: "EconomikWalletAccount_memberId_fkey")

  balanceCents Int @default(0)

  transactions HubWalletTransaction[]
  requests     HubWalletRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("EconomikWalletAccount")
}

model HubWalletTransaction {
  id        String           @id @default(cuid())
  accountId String
  account   HubWalletAccount @relation(fields: [accountId], references: [id], map: "EconomikWalletTransaction_accountId_fkey")

  type        HubWalletTransactionType
  amountCents Int
  description String?
  status      HubWalletTransactionStatus @default(PENDING)

  sourceType     HubWalletSourceType?
  sourceId       String?
  sourceNote     String?
  idempotencyKey String?              @unique(map: "EconomikWalletTransaction_idempotencyKey_key")

  createdById String?
  createdBy   HubMember? @relation("EconomikWalletTransactionCreatedBy", fields: [createdById], references: [id], map: "EconomikWalletTransaction_createdById_fkey")

  createdAt DateTime @default(now())

  @@index([accountId], map: "EconomikWalletTransaction_accountId_idx")
  @@map("EconomikWalletTransaction")
}

enum HubWalletTransactionType {
  CREDIT
  DEBIT
  ADJUSTMENT

  @@map("EconomikWalletTransactionType")
}

enum HubWalletTransactionStatus {
  PENDING
  COMPLETED
  CANCELLED

  @@map("EconomikWalletTransactionStatus")
}

enum HubWalletSourceType {
  PROJECT_PAYOUT
  PROJECT_REVERSAL
  MANUAL_ADJUSTMENT
  TRANSACTION_REVERSAL
  REQUEST_APPROVAL
  SYSTEM

  @@map("EconomikWalletSourceType")
}

model HubWalletRequest {
  id             String           @id @default(cuid())
  idempotencyKey String?          @unique(map: "EconomikWalletRequest_idempotencyKey_key")
  accountId      String
  account        HubWalletAccount @relation(fields: [accountId], references: [id], map: "EconomikWalletRequest_accountId_fkey")

  memberId String
  member   HubMember @relation(fields: [memberId], references: [id], map: "EconomikWalletRequest_memberId_fkey")

  amountCents Int
  reason      String?
  status      HubWalletRequestStatus @default(PENDING)

  reviewedById String?
  reviewedBy   HubMember? @relation("EconomikWalletReviewedBy", fields: [reviewedById], references: [id], map: "EconomikWalletRequest_reviewedById_fkey")
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId], map: "EconomikWalletRequest_accountId_idx")
  @@index([status], map: "EconomikWalletRequest_status_idx")
  @@map("EconomikWalletRequest")
}

enum HubWalletRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("EconomikWalletRequestStatus")
}

model HubAuditLog {
  id             String          @id @default(cuid())
  organizationId String          @map("workspaceId")
  organization   HubOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "EconomikAuditLog_workspaceId_fkey")

  action   String
  entity   String
  entityId String?
  memberId String?
  member   HubMember? @relation(fields: [memberId], references: [id], onDelete: SetNull, map: "EconomikAuditLog_memberId_fkey")

  metadata Json?

  createdAt DateTime @default(now())

  @@index([organizationId], map: "EconomikAuditLog_workspaceId_idx")
  @@index([action], map: "EconomikAuditLog_action_idx")
  @@index([createdAt], map: "EconomikAuditLog_createdAt_idx")
  @@map("EconomikAuditLog")
}

model HubNotification {
  id                String          @id @default(cuid())
  organizationId    String
  organization      HubOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipientMemberId String
  recipientMember   HubMember       @relation("HubNotificationRecipient", fields: [recipientMemberId], references: [id], onDelete: Cascade)
  actorMemberId     String?
  actorMember       HubMember?      @relation("HubNotificationActor", fields: [actorMemberId], references: [id], onDelete: SetNull)
  type              String
  title             String
  body              String
  href              String
  entityType        String
  entityId          String
  idempotencyKey    String
  readAt            DateTime?
  archivedAt        DateTime?
  dismissedAt       DateTime?
  deletedAt         DateTime?
  version           Int             @default(1)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, recipientMemberId, readAt])
  @@index([recipientMemberId, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
}

enum HubAvailabilityExceptionType {
  AVAILABLE
  UNAVAILABLE
}

model HubAvailabilityRule {
  id             String          @id @default(cuid())
  organizationId String
  organization   HubOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String
  member         HubMember       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  weekday        Int
  startMinute    Int
  endMinute      Int
  timezone       String
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, memberId])
  @@index([memberId, weekday])
}

model HubAvailabilityException {
  id             String                       @id @default(cuid())
  organizationId String
  organization   HubOrganization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String
  member         HubMember                    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  date           DateTime                     @db.Date
  type           HubAvailabilityExceptionType
  startMinute    Int?
  endMinute      Int?
  reason         String?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  @@index([organizationId, memberId])
  @@index([memberId, date])
}

enum HubMeetingStatus {
  DRAFT
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum HubMeetingParticipantStatus {
  PENDING
  ACCEPTED
  DECLINED
  TENTATIVE
  ATTENDED
  ABSENT
}

model HubMeeting {
  id               String                    @id @default(cuid())
  organizationId   String
  organization     HubOrganization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  directorateId    String?
  organizationWide Boolean                   @default(false)
  version          Int                       @default(1)
  directorate      HubDirectorate?           @relation(fields: [directorateId], references: [id], onDelete: SetNull)
  title            String
  description      String?
  status           HubMeetingStatus          @default(DRAFT)
  startAt          DateTime
  endAt            DateTime
  timezone         String
  location         String?
  meetingUrl       String?
  createdById      String
  createdBy        HubMember                 @relation("HubMeetingCreator", fields: [createdById], references: [id])
  cancelledAt      DateTime?
  cancelledById    String?
  cancelledBy      HubMember?                @relation("HubMeetingCanceller", fields: [cancelledById], references: [id])
  cancelReason     String?
  completedAt      DateTime?
  minutes          String?
  idempotencyKey   String
  requestHash      String?
  participants     HubMeetingParticipant[]
  directorates     HubMeetingDirectorate[]
  externalGuests   HubMeetingExternalGuest[]
  responseEvents   HubMeetingResponseEvent[]
  agendaItems      HubMeetingAgendaItem[]
  decisions        HubMeetingDecision[]
  sourceTasks      HubTask[]
  calendarEvents   HubCalendarEvent[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, startAt])
  @@index([directorateId, startAt])
  @@index([createdById])
}

enum HubAvailabilityPollStatus {
  OPEN
  CLOSED
  SCHEDULED
  CANCELLED
}

model HubAvailabilityPoll {
  id               String                           @id @default(cuid())
  organizationId   String
  organization     HubOrganization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  dates            DateTime[]                       @db.Date
  startMinute      Int
  endMinute        Int
  slotMinutes      Int
  timezone         String
  responseDeadline DateTime?
  directorateId    String?
  directorate      HubDirectorate?                  @relation(fields: [directorateId], references: [id], onDelete: SetNull)
  status           HubAvailabilityPollStatus        @default(OPEN)
  createdById      String
  createdBy        HubMember                        @relation("HubAvailabilityPollCreator", fields: [createdById], references: [id])
  version          Int                              @default(1)
  participants     HubAvailabilityPollParticipant[]
  selections       HubAvailabilitySelection[]
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt

  @@index([organizationId, status])
  @@index([directorateId])
}

model HubAvailabilityPollParticipant {
  id        String              @id @default(cuid())
  pollId    String
  poll      HubAvailabilityPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  memberId  String
  member    HubMember           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime            @default(now())

  @@unique([pollId, memberId])
  @@index([memberId])
}

model HubAvailabilitySelection {
  id        String              @id @default(cuid())
  pollId    String
  poll      HubAvailabilityPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  memberId  String
  member    HubMember           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  slotStart DateTime
  createdAt DateTime            @default(now())

  @@unique([pollId, memberId, slotStart])
  @@index([pollId, slotStart])
  @@index([memberId])
}

model HubMeetingDirectorate {
